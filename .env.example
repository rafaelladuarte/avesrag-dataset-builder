# Copie para .env e preencha. Veja a tabela de variáveis no README.

# Chaves de API: cada comando só cobra a sua
OPENAI_API_KEY=            # extract, docs (quando há embedding a gerar) e index --fumaca
EBIRD_API_KEY=             # ingest ebird (gratuita: https://ebird.org/api/keygen)

# MongoDB do docker-compose. Se a porta 27017 já estiver em uso na sua máquina,
# troque as duas linhas para outra porta (ex.: 27018).
MONGODB_PORT=27017         # porta publicada pelo docker-compose
MONGODB_URI=mongodb://localhost:27017/?directConnection=true

# Opcionais
MONGODB_DATABASE=avesrag
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-large
PILOTO_MUNICIPIO_IBGE=3170206   # Uberlândia (MG)
WIKIAVES_MAX_ESPECIES=0         # 0 = sem limite
# AVESRAG_LOG_FILE=avesrag.log  # grava o log também em arquivo
