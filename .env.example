# MongoDB Credentials
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123

# Mongo Express Credentials (Web Interface)
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=admin123

# Connection URIs
MONGODB_URI=mongodb://admin:password123@localhost:27017/?authSource=admin
MONGODB_DATABASE=avesrag
POSTGRES_URI=postgresql://aves:aves@localhost:5432/avesrag

# eBird API
EBIRD_API_KEY=your_ebird_api_key_here

# WikiAves Scraping (0 = sem limite)
MAX_ESPECIES=0

# LLM
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Rate Limiting (ajuste conforme seu tier)
GEMINI_RPM=10        # Requests per minute
GEMINI_TPM=250000    # Tokens per minute
GEMINI_RPD=500       # Requests per day
